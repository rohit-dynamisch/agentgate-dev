# deploy/g6/Dockerfile.agentgate — G6 AgentGate Service Packaging
FROM golang:1.24-alpine AS build
ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY agentgate/go.mod agentgate/go.sum ./agentgate/
WORKDIR /src/agentgate
RUN go mod download
WORKDIR /src
COPY agentgate/ ./agentgate/
WORKDIR /src/agentgate
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/agentgate ./cmd/agentgate

FROM alpine:3.20
RUN apk add --no-cache curl wget ca-certificates
COPY --from=build /out/agentgate /usr/local/bin/agentgate
ENV AGENTGATE_HTTP_ADDR=":8090"
ENV AGENTGATE_AUTHZ_GRPC_ADDR=":9001"
ENV AGENTGATE_ENV="development"
ENV AGENTGATE_LOG_LEVEL="info"
ENV AGENTGATE_ADMIN_TOKEN="agentgate-admin-secret-dev"
EXPOSE 8090 9001
ENTRYPOINT ["/usr/local/bin/agentgate"]
